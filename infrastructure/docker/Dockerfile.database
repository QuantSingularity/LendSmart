# syntax=docker/dockerfile:1
FROM mongo:7

# Apply custom MongoDB configuration
COPY docker/mongod.conf /etc/mongod.conf

# Copy database initialisation scripts (optional - place .js/.sh files here)
# COPY db/init/ /docker-entrypoint-initdb.d/

EXPOSE 27017

# Run mongod with the custom configuration file
CMD ["mongod", "--config", "/etc/mongod.conf"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
  CMD mongosh --quiet --eval "db.adminCommand('ping')" || exit 1
